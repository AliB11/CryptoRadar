# ——— نمونهٔ متغیرهای محیطی — مقادیر واقعی را در ورسل تنظیم کنید، نه اینجا ———

# انبارِ وضعیت (Upstash Redis — رایگان). بدون آن، سرور از حافظه/فایل استفاده می‌کند
# که بین اجراهایِ serverless پایدار نیست.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# توکنِ پایش: مرورگر و زمان‌سنج با آن احراز هویت می‌شوند. بدون آن /api/state پاسخ نمی‌دهد.
RADAR_TOKEN=

# همان چیزی که کرونِ ورسل به‌عنوان Authorization: Bearer <secret> می‌فرستد.
# /api/pulse هر دو را می‌پذیرد: CRON_SECRET (Bearer) یا RADAR_TOKEN (x-radar-token).
CRON_SECRET=

# کلیدهای Web Push — با `node tools/vapid.mjs` تولید کنید.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# اگر ست شود، تیکِ سرور برای قیمت از پروکسیِ همین دامنه می‌خواند
# (CoinGecko و در صورت خطا fallback قیمت CoinLore).
# خالی بگذارید تا CoinGecko مستقیم و سپس fallback قیمت CoinLore را امتحان کند.
RADAR_PROXY_ORIGIN=

# رفتارِ موتور
PULSE_INTERVAL_SEC=90          # چرخهٔ هدف (۳۰..۳۶۰۰)
PAPER_AUTO_EXEC=true           # ثبتِ خودکارِ اجرای کاغذی
PAPER_SLIPPAGE_BPS=10          # لغزشِ بدبینانهٔ خروج‌های بازاری (۰/۱٪)
SIGNAL_SCAN_SEC=120            # فاصلهٔ اسکنِ سیگنال در سمت سرور (۶۰..۳۶۰۰)
RADAR_SPACE=default            # فضای نام

# اختیاری: سنجه‌های زنجیره‌ای CryptoQuant (https://cryptoquant.com/)
# بدون کلید، یکپاسخِ `not-configured` برمی‌گردد و هیچ چیزی مسدود نمی‌شود.
# کلید به پلن Professional/Premium نیاز دارد و هرگز به مرورگر فرستاده نمی‌شود.
CRYPTOQUANT_API_KEY=
# با ONCHAIN_GATE=off سنجه‌ها فقط نمایش داده می‌شوند و هرگز ورود جدید را نمی‌بندند.
ONCHAIN_GATE=
# آستانه‌های دروازه (پیش‌فرض‌ها):
CQ_NETFLOW_Z=2                 # z-اسکور جریان خالص صرافی برای مسدودکردن ورود
CQ_SOPR_HIGH=1.05              # سوددهیِ افراطی
CQ_SOPR_LOW=0.93               # فروشِ وحشتناک

# اختیاری اما توصیه‌شده برای محدودیت درخواست CoinGecko؛ فقط در سرور تنظیم شود.
# یکی را تنظیم کنید؛ Pro اولویت دارد و دامنهٔ Pro به صورت خودکار انتخاب می‌شود.
COINGECKO_DEMO_API_KEY=
COINGECKO_PRO_API_KEY=

# ---------------------------------------------------------------------------
# زنجرهٔ بازیابی داده (بدون کلید، خودکار — چیزی برای تنظیم ندارید)
#
# ۱) CoinGecko   ۲) Binance (کندل ۱ساعته → بازسازی سری ساعتی)
# ۳) CoinLore (snapshot)   ۴) شبیه‌سازی
#
# استخرِ عمومیِ CoinGecko به‌ازای هر IP محدود است؛ وقتی 429 می‌گیرد، لایهٔ ۲
# تاریخچهٔ ساعتی را بازمی‌سازد تا موتورِ تحلیل خاموش نشود. ارزش بازار و شناسه‌ها
# از لایهٔ ۳ می‌آید و سن/ATH پروژه در این حالت در دسترس نیست.
# ---------------------------------------------------------------------------
