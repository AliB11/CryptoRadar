# ——— نمونهٔ متغیرهای محیطی — مقادیر واقعی را در ورسل تنظیم کنید، نه اینجا ———

# انبارِ وضعیت (Upstash Redis — رایگان). بدون آن، سرور از حافظه/فایل استفاده می‌کند
# که بین اجراهایِ serverless پایدار نیست.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# توکنِ پایش: مرورگر و زمان‌سنج با آن احراز هویت می‌شوند. بدون آن /api/state پاسخ نمی‌دهد.
RADAR_TOKEN=

# همان چیزی که کرونِ ورسل به‌عنوان Authorization: Bearer <secret> می‌فرستد.
# /api/pulse هر دو را می‌پذیرد: CRON_SECRET (Bearer) یا RADAR_TOKEN (x-radar-token).
CRON_SECRET=

# کلیدهای Web Push — با `node tools/vapid.mjs` تولید کنید.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# اگر ست شود، تیکِ سرور برای قیمت از پروکسیِ همین دامنه می‌خواند
# (CoinGecko و در صورت خطا fallback قیمت CoinLore).
# خالی بگذارید تا CoinGecko مستقیم و سپس fallback قیمت CoinLore را امتحان کند.
RADAR_PROXY_ORIGIN=

# رفتارِ موتور
PULSE_INTERVAL_SEC=90          # چرخهٔ هدف (۳۰..۳۶۰۰)
PAPER_AUTO_EXEC=true           # ثبتِ خودکارِ اجرای کاغذی
PAPER_SLIPPAGE_BPS=10          # لغزشِ بدبینانهٔ خروج‌های بازاری (۰/۱٪)
RADAR_SPACE=default            # فضای نام

# اختیاری اما توصیه‌شده برای محدودیت درخواست CoinGecko؛ فقط در سرور تنظیم شود.
# یکی را تنظیم کنید؛ Pro اولویت دارد و دامنهٔ Pro به صورت خودکار انتخاب می‌شود.
COINGECKO_DEMO_API_KEY=
COINGECKO_PRO_API_KEY=
